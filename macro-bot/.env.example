# Example environment variables for macro-bot / investment_tool server deployment.
# Copy this file to .env and fill in real values.
# Do NOT commit .env to Git.

# ===== Existing required variables =====
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_WEBHOOK
FEISHU_SIGN_SECRET=YOUR_SIGN_SECRET
KIMI_API_KEY=YOUR_KIMI_API_KEY
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ===== Kimi CLI / datasource configuration (T8) =====
# Path to Node.js binary on the server.
KIMI_DATASOURCE_NODE=/usr/bin/node

# Path to the installed kimi-datasource plugin entry script on the server.
# Install with: scripts/setup-kimi-datasource.sh
KIMI_DATASOURCE_SCRIPT=/root/.kimi-code/plugins/managed/kimi-datasource/bin/kimi-datasource.mjs

# Kimi OAuth endpoints (rarely need to change).
KIMI_CODE_OAUTH_HOST=https://auth.kimi.com
KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1

# Optional: enable/disable Kimi datasource enrichment in bot.py.
# Set to "false" to keep briefing generation unchanged.
KIMI_DATASOURCE_ENABLED=true

# Optional: stock position size threshold (USD) for fetching Tonghuashun data.
KIMI_STOCK_ENRICHMENT_MIN_SIZE=10000000
