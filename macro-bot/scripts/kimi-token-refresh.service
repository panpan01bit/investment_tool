[Unit]
Description=Refresh Kimi CLI access token for datasource MCP
After=network.target

[Service]
Type=oneshot
User=root
ExecStart=/root/.kimi-code/scripts/refresh-token.sh
StandardOutput=append:/var/log/kimi-token-refresh.log
StandardError=append:/var/log/kimi-token-refresh.log

[Install]
WantedBy=multi-user.target
