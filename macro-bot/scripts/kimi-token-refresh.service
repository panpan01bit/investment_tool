[Unit]
Description=Refresh Kimi Code access token for datasource MCP
After=network.target

[Service]
Type=oneshot
User=root
ExecStart=/www/wwwroot/investment_tool/macro-bot/scripts/refresh-token.sh
StandardOutput=append:/var/log/kimi-token-refresh.log
StandardError=append:/var/log/kimi-token-refresh.log

[Install]
WantedBy=multi-user.target
