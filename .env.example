# investlab 配置模板 —— 复制为 .env 后填写（.env 已被 gitignore，永不入库）
# =====================================================================

# ---------- 必填：LLM（OpenAI 兼容协议）----------
# 默认指向 Kimi/Moonshot；也可替换为任何 OpenAI 兼容端点
INVESTLAB_LLM_BASE_URL=https://api.moonshot.cn/v1
INVESTLAB_LLM_API_KEY=
# 快速模型（摘要/标签/问答）
INVESTLAB_LLM_MODEL=kimi-k2.5
# 思考模型（深度分析/晨报结论）
INVESTLAB_LLM_THINKING_MODEL=kimi-k2-thinking
# 视觉模型（券商报告图表理解；留空则跳过图表数据化，仅存图）
# Kimi 的视觉模型示例：moonshot-v1-32k-vision-preview
INVESTLAB_LLM_VISION_MODEL=

# ---------- 可选：数据源增强 ----------
# Tushare Pro token（https://tushare.pro 注册，积分制）
TUSHARE_TOKEN=
# 美联储 FRED API key（美国宏观数据）
FRED_API_KEY=

# ---------- 可选：搜索增强 ----------
# DuckDuckGo 搜索免费内置，无需任何配置。
# 配置 Tavily 后自动叠加使用（结果更多更稳）：https://tavily.com
TAVILY_API_KEY=

# ---------- 可选：社媒热度（免费源，无需配置即可用） ----------
# Reddit/HN/Polymarket/StockTwits 零密钥；GitHub 搜索匿名限额 10次/分钟，
# 配置个人 token 后提升到 30次/分钟（https://github.com/settings/tokens，无需勾权限）
GITHUB_TOKEN=

# ---------- 可选：手机推送（晨报生成后通知，替代旧飞书推送） ----------
# 方案一：ntfy（手机装 ntfy App 订阅一个自定义主题名即可）
INVESTLAB_NOTIFY_NTFY_TOPIC=
# 自建 ntfy 服务器则填写，默认官方 https://ntfy.sh
#INVESTLAB_NOTIFY_NTFY_SERVER=https://ntfy.sh
# 方案二：Bark（iOS）。安装 Bark App 后复制它的推送 URL
INVESTLAB_NOTIFY_BARK_URL=
# 若推送目标是内网自建服务器（10.x/192.168.x 等），需显式放行：
#INVESTLAB_NOTIFY_ALLOW_PRIVATE=1

# ---------- 本地路径 ----------
# 数据目录（简报JSON/报告库/缓存），默认 <repo>/data
#INVESTLAB_DATA_DIR=./data
# Obsidian Vault 路径（重要！指向你的仓库根目录或新建一个）
# 建议在 Obsidian 中"打开本地仓库作为 Vault"，然后把这个目录填到这里
INVESTLAB_OBSIDIAN_VAULT=~/Obsidian/investlab-vault
# 券商报告收件箱（CLI ingest 时可放这里）
#INVESTLAB_REPORTS_INBOX=

# ---------- 行为开关 ----------
# 券商报告解析时是否调用视觉模型结构化图表
INVESTLAB_REPORT_VISION=1
# 研报文本解析引擎：pymupdf（默认，零依赖）| mineru（实验性，
# 需先 pip install "magic-pdf[full]" 并下载模型；复杂表格/公式更准）
INVESTLAB_REPORT_ENGINE=pymupdf
# 量化模块是否允许联网取数（0 = 纯离线演示）
INVESTLAB_QUANT_NET=1
# 日志级别 DEBUG/INFO/WARNING
INVESTLAB_LOG_LEVEL=INFO

# ---------- 预留：线上部署（本机使用无需改动）----------
# API 监听地址。上线部署时改 0.0.0.0 并务必关闭 auth_disabled、设置强口令
INVESTLAB_API_HOST=127.0.0.1
INVESTLAB_API_PORT=8300
# CORS 允许来源（逗号分隔）；前端开发服务器默认已含
INVESTLAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 关闭鉴权仅限本机模式；对外部署必须设为 0 并设置管理员口令
INVESTLAB_AUTH_DISABLED=1
INVESTLAB_ADMIN_USERNAME=admin
INVESTLAB_ADMIN_PASSWORD=
# 服务间内部调用的共享密钥（预留）
INVESTLAB_INTERNAL_SECRET=

# ---------- 兼容旧 macro-bot 的变量名（可选） ----------
# KIMI_API_KEY / KIMI_BASE_URL / KIMI_MODEL / KIMI_STRONG_MODEL 仍会被识别，
# 但建议迁移到上面的 INVESTLAB_LLM_* 命名。FEISHU_* 已废弃不再读取。
